# Postgres connection string (Vercel Postgres, Neon, Supabase, Prisma Postgres, or any Postgres host)
DATABASE_URL="postgres://username:password@host:5432/database?sslmode=require"

# A long random string used to sign admin login session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Login credentials for the owner admin account. The owner can approve or
# reject changes submitted by the assistant account below.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# Login credentials for the assistant admin account. Anything the assistant
# does that leads to a cash deduction (marking someone late/absent, applying
# an infraction, or changing a penalty amount) is queued for the owner to
# approve instead of taking effect immediately.
ASSISTANT_USERNAME="assistant"
ASSISTANT_PASSWORD="change-this-password-too"
