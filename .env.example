# Postgres connection string (Vercel Postgres, Neon, Supabase, Prisma Postgres, or any Postgres host)
DATABASE_URL="postgres://username:password@host:5432/database?sslmode=require"

# A long random string used to sign admin login session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Login accounts are stored in the database (AdminAccount table), not env
# vars - this supports multiple departments, each with its own owner
# (manager) and assistant account. See prisma/schema.prisma (Department,
# AdminAccount) to add or manage accounts.
