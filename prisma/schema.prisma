generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  OFF_DAY
}

enum InfractionType {
  MINOR
  MAJOR
  MISCELLANEOUS
}

enum PendingChangeKind {
  ATTENDANCE
  INFRACTION
  PENALTY_RULE
  BIOMETRIC_RESET
}

enum PendingChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminRole {
  OWNER
  ASSISTANT
}

// A separate team/roster with its own employees, penalty rules, and admin
// logins. Nothing is shared between departments except the app itself.
model Department {
  id                 String           @id @default(cuid())
  name               String           @unique
  venueName          String?          // e.g. "Studio A / Main Venue"
  venueLatitude      Float?           // e.g. 6.5244
  venueLongitude     Float?           // e.g. 3.3792
  venueRadiusMeters  Int              @default(100) // Allowed check-in radius from venue center
  checkInStartTime   String           @default("07:00") // Earliest check-in (HH:mm)
  checkInCutoffTime  String           @default("09:15") // On-time cutoff; later is LATE (HH:mm)
  checkInEndTime     String           @default("13:00") // Latest check-in window (HH:mm)
  checkOutStartTime  String           @default("16:30") // Earliest check-out window (HH:mm)
  checkOutEndTime    String           @default("21:00") // Latest check-out window (HH:mm)
  createdAt          DateTime         @default(now())
  employees          Employee[]
  penaltyRules       PenaltyRule[]
  admins             AdminAccount[]
  pendingChanges     PendingChange[]

  @@map("departments")
}

// Login accounts. Replaces the old env-var-based single admin/assistant
// pair now that there can be more than one department, each with its own
// owner (manager) and assistant.
model AdminAccount {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         AdminRole
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@map("admin_accounts")
}

model Employee {
  id                   String                @id @default(cuid())
  departmentId         String
  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name                 String
  role                 String
  active               Boolean               @default(true)
  // Days of week this employee is normally scheduled to work.
  // 0 = Sunday ... 6 = Saturday. Any day NOT in this list is treated as an off day.
  workingDays          Int[]                 @default([0, 1, 2, 3, 4, 5, 6])
  biometricResetRequested Boolean            @default(false)
  biometricResetAllowed   Boolean            @default(false)
  // Custom shift timings (optional overrides for this specific employee)
  customCheckInStartTime  String?
  customCheckInCutoffTime String?
  customCheckInEndTime    String?
  customCheckOutStartTime String?
  customCheckOutEndTime   String?
  // PIN check-in for devices without biometrics (strictly admin controlled)
  pinCheckInAllowed       Boolean               @default(false)
  pinHash                 String?
  createdAt            DateTime              @default(now())
  attendance           Attendance[]
  infractions          Infraction[]
  biometricCredentials BiometricCredential[]

  @@map("employees")
}

model Attendance {
  id             String           @id @default(cuid())
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  status         AttendanceStatus
  note           String?
  checkInTime    DateTime?
  checkOutTime   DateTime?
  checkInLat     Float?
  checkInLng     Float?
  checkOutLat    Float?
  checkOutLng    Float?
  checkInMethod  String?          // "BIOMETRIC_MOBILE" | "MANUAL_ADMIN"
  checkOutMethod String?          // "BIOMETRIC_MOBILE" | "MANUAL_ADMIN"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([employeeId, date])
  @@map("attendance")
}

model BiometricCredential {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String[] @default([])
  deviceName   String?
  createdAt    DateTime @default(now())

  @@map("biometric_credentials")
}

model BiometricChallenge {
  id         String   @id @default(cuid())
  employeeId String?
  challenge  String
  purpose    String   // "REGISTRATION" | "AUTHENTICATION"
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("biometric_challenges")
}

model Infraction {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime       @db.Date
  type        InfractionType
  description String?
  amount      Int
  createdAt   DateTime       @default(now())

  @@map("infractions")
}

// Configurable cash-penalty amounts (in your local currency's smallest
// display unit, e.g. Naira) applied per occurrence of each deduction type.
// Each department keeps its own independent set.
model PenaltyRule {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  key          String // LATE | ABSENT | MINOR_INFRACTION | MAJOR_INFRACTION | MISCELLANEOUS
  label        String
  amount       Int

  @@unique([departmentId, key])
  @@map("penalty_rules")
}

// A change submitted by the assistant admin account that leads to a cash
// deduction (marking someone late/absent, applying an infraction, or
// re-pricing a penalty rule). It sits here, unapplied, until the owner
// admin approves or rejects it.
model PendingChange {
  id           String              @id @default(cuid())
  departmentId String
  department   Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  kind         PendingChangeKind
  summary      String
  payload      Json
  requestedBy  String
  status       PendingChangeStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?

  @@map("pending_changes")
}
